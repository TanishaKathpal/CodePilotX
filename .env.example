# Copy to .env and fill in. NEVER commit .env.

# ---- LLM (choose one provider) ----
LLM_PROVIDER=anthropic              # anthropic | openai_compatible
LLM_MODEL=claude-sonnet-5-5         # any model id your provider supports
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# For OpenAI / Ollama / vLLM / LM Studio (LLM_PROVIDER=openai_compatible):
OPENAI_API_KEY=
# OPENAI_BASE_URL=http://localhost:11434/v1    # e.g. Ollama (no key needed)

# LLM_MAX_TOKENS=4096
# LLM_TIMEOUT_S=120
# LLM_TEMPERATURE=                  # leave unset unless your model supports it

# ---- Retrieval ----
EMBEDDING_BACKEND=hashing           # hashing (offline) | sentence-transformers
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# TOP_K=8

# ---- Repository limits ----
# MAX_REPO_MB=50
# MAX_FILES_INDEXED=1500
# MAX_FILE_KB=200
# CLONE_TIMEOUT_S=90

# ---- Sandbox (Docker) ----
# SANDBOX_IMAGE=codepilotx-sandbox:latest
# SANDBOX_MEMORY=512m
# SANDBOX_CPUS=1.0
# SANDBOX_PIDS=128
# SANDBOX_TIMEOUT_S=120

# ---- Agent ----
# MAX_FIX_ATTEMPTS=2
# USE_LANGGRAPH=true
# MAX_CONCURRENT_JOBS=2
# KEEP_WORKSPACE=false              # true = keep job folders for debugging
# CORS_ORIGINS=http://localhost:5173
